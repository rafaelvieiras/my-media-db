# MyMediaDB -- optional provider credentials.
#
# Copy this file to `.env` and fill what you have. `.env` is gitignored and must
# never be committed.
#
# Every key is optional. Without them the app starts normally and the external
# search and enrichment stay off -- it degrades, it does not break. Fill in only
# the providers you want to use.
#
# You can also set each provider from the UI (Integrations screen). The UI value
# wins over the environment.

# TMDB -- https://www.themoviedb.org/settings/api
# One of the two is enough: the v4 token is preferred, the v3 API key works too.
MYMEDIADB_TMDB_TOKEN=
MYMEDIADB_TMDB_API_KEY=

# fanart.tv -- artwork-only provider (extra posters, backgrounds, stills).
MYMEDIADB_FANARTTV_API_KEY=

# TheTVDB -- series enrichment. The variable is TTDB, not TVDB, on purpose: the
# prefix must match what the provider registry expects.
MYMEDIADB_TTDB_API_KEY=

# AcoustID -- audio fingerprint lookup for music files.
MYMEDIADB_ACOUSTID_CLIENT_KEY=
