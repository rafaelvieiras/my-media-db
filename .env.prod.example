# ─────────────────────────────────────────────────────────────────────────────
# MyMediaDB — modelo do .env de PRODUÇÃO (usado por compose.prod.yaml).
# Copie este arquivo para `.env` (na raiz) e preencha o que tiver. O `.env`
# real é gitignored e NUNCA deve ser versionado — só este exemplo, sem valores
# reais, entra no git.
#
# TODAS as chaves abaixo são OPCIONAIS: sem elas o app sobe normalmente e a
# busca/enriquecimento externos (TMDB, fanart.tv, TVDB) ficam desligados —
# degrada, não quebra. Preencha só os provedores que quiser usar.
# ─────────────────────────────────────────────────────────────────────────────

# TMDB — https://www.themoviedb.org/settings/api (basta uma das duas: token
# v4 preferido, ou API key v3 clássica).
MYMEDIADB_TMDB_API_KEY=
MYMEDIADB_TMDB_TOKEN=

# fanart.tv — provider só-de-arte (pôsteres/fanart/still adicionais).
MYMEDIADB_FANARTTV_API_KEY=

# TheTVDB — enriquecimento de séries. Nome da env é TTDB (não TVDB) porque é
# assim que o código já lê hoje — mantenha exatamente este nome.
MYMEDIADB_TTDB_API_KEY=
