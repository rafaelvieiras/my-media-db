# Dependencies and artifacts that must NOT enter the build context.
# The build has to work even with nothing pre-built locally: the real SPA dist
# is generated in the builder-web stage, not copied from the host.

# Node
node_modules/
**/node_modules/

# Local build of the embedded SPA: the placeholder and any local build must NOT
# leak into the context — the real dist comes from stage 1 of the Dockerfile.
internal/webui/dist/

# Git
.git/
.gitignore

# Local artifacts and temporary files
*.sqlite
.env
*.log
reports/
tmp/
dist/
dist-ssr/
*.local

# The packaging itself
Dockerfile
.dockerignore

# Development environment with hot reload: dev only, it never
# enters the production image.
compose.dev.yaml
Dockerfile.dev
.air.toml

# Quality gate (dev/CI tooling): it does not go into the production image.
scripts/
baseline.json
lefthook.yml
.golangci.yml
Makefile
.github/
CONTRIBUTING.md
docs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
