# DEV image for the backend. Meant only for the development loop: it installs
# air (the watcher) once, at build time, so the following `up`s are fast.
# This is NOT the production image — that one is the multi-stage Dockerfile at
# the root.
FROM golang:1.26

WORKDIR /app

# ffprobe (the ffmpeg package) is a RUNTIME dependency of the scanner (ADR-0014):
# without it the mediainfo is written empty (it degrades, it does not break). The
# production image already installs it (root Dockerfile, `apk add ffmpeg`);
# replicating it here gives dev/prod PARITY, otherwise the mediainfo never shows
# up in the development loop.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# air is a dev-only dependency. CURRENT module: github.com/air-verse/air
# (the old cosmtrek/air is discontinued). Installed into $GOPATH/bin, which is
# already on the PATH of the official Go image.
RUN go install github.com/air-verse/air@latest

# Uid/gid 1000:1000 at runtime: parity with compose.yaml —
# without it the service runs as root and the NFO/artwork exported to the
# host-mounted library are born owned by root, unreadable without sudo. The
# apt-get/go install above already ran as root (image build steps); only the
# CMD/runtime needs the non-root uid. GOCACHE points at a fixed path (it does
# not depend on $HOME, which changes with the user) so the named volume
# go-build-cache (see compose.dev.yaml) stays writable by uid 1000.
ENV GOCACHE=/go-cache
RUN mkdir -p /go-cache \
    && groupadd -g 1000 mymediadb \
    && useradd -u 1000 -g mymediadb -m -d /home/mymediadb mymediadb \
    && chown -R mymediadb:mymediadb /go /go-cache

USER mymediadb

# The code is mounted as a volume in compose; the real build happens via air at
# runtime. The module/build cache lives in named volumes (see compose.dev.yaml).
CMD ["air", "-c", ".air.toml"]
