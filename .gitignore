# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Frontend
node_modules/

# Web test coverage (vitest/v8): ephemeral reports, never versioned.
web/coverage/

# Vite build embedded in the Go binary: generated, never versioned.
# Only the index.html placeholder is tracked, so //go:embed compiles without the front end.
internal/webui/dist/*
!internal/webui/dist/index.html

# SQLite database and its WAL sidecars (-wal/-shm). The dev default lives in tmp/.
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

# Production data (bind mount of compose.yaml): SQLite, downloaded artwork and
# backups. Never version the owner's collection.
/data/

# Quality gate: ephemeral collector reports (coverage, jscpd, golangci...) and the
# temporary directory. baseline.json IS tracked, because the ratchet depends on it.
reports/
tmp/

# Playwright MCP artifacts (validation snapshots)
.playwright-mcp/

# Server binary when built at the root (for example `go build ./cmd/...`). The
# release binary is built in CI/Docker and never versioned.
/mymediadb
