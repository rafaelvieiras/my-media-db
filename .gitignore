# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Frontend
node_modules/

# Cobertura de testes do web (vitest/v8): relatórios efêmeros, não versionar.
web/coverage/

# Build do Vite embutido no binário Go: é gerado (ver briefings 0002/0003).
# Só o placeholder index.html é versionado, para o //go:embed compilar sem o front.
internal/webui/dist/*
!internal/webui/dist/index.html

# Banco SQLite e seus sidecars do WAL (-wal/-shm). O default de dev fica em tmp/.
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

# Dados de produção (bind-mount do compose.prod.yaml): SQLite + arte baixada +
# backups. Nunca versionar a coleção do usuário.
/data/

# Quality gate: relatórios efêmeros dos coletores (cobertura, jscpd, golangci…)
# e diretório temporário. O baseline.json É versionado (a catraca depende dele).
reports/
tmp/

# Artefatos do Playwright MCP (snapshots de validação)
.playwright-mcp/

# Binário do servidor quando buildado na raiz (ex.: `go build ./cmd/...`). O
# binário de release é gerado no CI/Docker, nunca versionado.
/mymediadb
